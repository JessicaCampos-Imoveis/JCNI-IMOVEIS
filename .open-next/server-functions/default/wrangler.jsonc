{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nome do Worker no Cloudflare (deve corresponder ao worker "jcni" criado no dashboard)
  "name": "jcni",
  // Arquivo principal gerado pelo @opennextjs/cloudflare build
  "main": ".open-next/worker.js",
  // Data minima de compatibilidade — manter em 2025-04-01 ou mais recente
  "compatibility_date": "2025-04-01",
  // nodejs_compat: habilita APIs do Node.js no ambiente Workers (necessario para Prisma, crypto etc.)
  "compatibility_flags": ["nodejs_compat"],
  // Assets estaticos gerados pelo build (HTML, JS, CSS, imagens publicas)
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  }
}
